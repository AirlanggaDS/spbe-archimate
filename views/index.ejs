<!DOCTYPE html>
<html lang="id">

<head>
  <meta charset="UTF-8" />
  <title>PlantUML ArchiMate Generator</title>
  <style>
    * {
      box-sizing: border-box;
    }

    body {
      font-family: Arial, sans-serif;
      margin: 0;
      padding: 0;
      background-color: #f4f4f4;
    }


    .panel {
      padding: 2em;
    }

    .container {
      display: flex;
      flex-direction: row;
      min-height: 100vh;
      /* pastikan tinggi penuh */
    }

    .left-panel {
      flex: 1;
      background-color: #ffffff;
      border-right: 1px solid #ddd;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2em;
    }

    .left-panel .info-box {
      max-width: 600px;
    }

    .right-panel {
      background-color: #f9f9f9;
      flex: 1;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 2em;
    }

    h1 {
      margin-top: 0;
    }

    .info-box {
      background: #f8f7f7;
      padding: 1em;
      border-radius: 8px;
      text-align: justify;
      align-items: center;
      justify-content: center;
    }

    .form-box {
      background: white;
      padding: 2em;
      border-radius: 10px;
      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
      width: 100%;
      max-width: 480px;
      display: flex;
      flex-direction: column;
    }

    .upload-area {
      border: 3px dashed #ccc;
      border-radius: 12px;
      padding: 60px 20px;
      text-align: center;
      background-color: #fafafa;
      cursor: pointer;
      margin-bottom: 25px;
      font-size: 1.2em;
      color: #555;
      min-height: 180px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .upload-area.dragover {
      background-color: #e6f4ff;
      border-color: #3399ff;
      color: #1a73e8;
    }

    input[type="file"] {
      display: none;
    }

    .buttons {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }

    .buttons button {
      flex: 1;
      padding: 12px 0;
      font-size: 1.1em;
      border-radius: 6px;
      border: none;
      cursor: pointer;
      background-color: #e79950;
      color: white;
      transition: background-color 0.3s ease;
    }

    .buttons button:hover {
      background-color: #50bce7;
    }

    .buttons a {
      flex: 1;
      text-decoration: none;
    }

    .buttons a button {
      width: 100%;
      height: 100%;
    }

    .file-info {
      margin-top: 10px;
      font-size: 1em;
      font-weight: bold;
      color: #28a745;
      word-break: break-word;
    }

    .upload-area.error .file-info {
      color: #d93025;
    }

    .popup {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background: rgba(0, 0, 0, 0.8);
      display: none;
      justify-content: center;
      align-items: center;
      z-index: 999;
      overflow: auto;
    }

    .popup img {
      max-height: 100%;
      max-width: none;
      border-radius: 8px;
      box-shadow: 0 0 10px #000;
      transition: transform 0.3s ease;
      object-fit: contain;
    }

    @media (min-width: 768px) {
      .container {
        flex-direction: row;
      }

      .left-panel {
        flex: 1;
        border-right: 1px solid #ddd;
        border-bottom: none;
      }

      .right-panel {
        flex: 1;
      }
    }
  </style>
</head>

<body>
  <div class="container">
    <div class="panel left-panel">
      <div class="info-box">
        <h1>Overview Sistem</h1>
        <p>
          Sistem ini dirancang untuk membantu dalam proses konversi metadata arsitektur SPBE ke dalam bentuk diagram
          <strong>ArchiMate</strong>. Dengan memanfaatkan file Excel sebagai input, sistem akan secara otomatis
          membangun model visual berdasarkan data yang telah diisi pengguna.
        </p>

        <h3>Panduan Penggunaan:</h3>
        <ol>
          <li>Unduh template Excel melalui tombol <strong>"Download Template"</strong>.</li>
          <li>Lengkapi metadata sesuai struktur yang tersedia pada <strong>21 sheet</strong> di dalam file template.
          </li>
          <li>Pastikan seluruh data terisi dengan benar dan sesuai format yang ditentukan.</li>
          <li>Unggah file Excel yang telah dilengkapi ke sistem melalui form upload.</li>
          <li>Klik tombol <strong>"Generate Diagram"</strong> untuk memproses dan menghasilkan diagram ArchiMate secara
            otomatis.</li>
        </ol>

        <h3>Panduan Pengisian Metadata:</h3>
        <ul>
          <li>Gunakan template Excel resmi dari sistem.</li>
          <li>Setiap sheet memiliki atribut wajib yang ditandai dengan kolom
            <span
              style="font-weight: bold; background-color: yellow; padding: 2px 4px; border: 1px solid #cccc00;">kuning</span>.
            Pastikan kolom tersebut diisi dengan benar.
          </li>
          <li>Ada juga atribut opsional yang ditandai dengan kolom
            <span
              style="font-weight: bold; background-color: orange; padding: 2px 4px; border: 1px solid #cc6600;">jingga</span>.
            Kolom ini boleh diisi atau tidak. Jika diisi, nilainya akan ditampilkan di diagram.
          </li>

          <li>Relasi antar metadata ditulis pada kolom <strong>'ID Metadata Terkait'</strong> dan dipisahkan dengan
            tanda koma (comma). Contohnya: <code>ID01,ID02,ID03</code>.</li>
          <li>Relasi mengikuti aturan dalam <strong>Surat Edaran Menteri PAN-RB No. 18 Tahun 2022</strong>, dan telah
            disesuaikan serta diverifikasi oleh pakar untuk pemetaan ke ArchiMate.</li>
        </ul>

        <div class="buttons" style="margin-top: 20px;">
          <button onclick="showPopup('aturan')">Lihat Aturan Relasi SPBE</button>
          <button onclick="showPopup('archimate')">Lihat Pemetaan ke ArchiMate</button>
        </div>
      </div>
    </div>

    <div class="panel right-panel">
      <div class="form-box">
        <h1>Upload Excel Metadata (21 Sheet)</h1>
        <form id="upload-form" action="/upload" method="post" enctype="multipart/form-data">
          <label for="file-input" class="upload-area" id="drop-area">
            <div>
              <p>Submit file atau drag & drop file Excel ke sini</p>
              <span id="file-status" class="file-info"></span>
            </div>
          </label>
          <input type="file" name="file" id="file-input" accept=".xls,.xlsx" required />
          <div class="buttons">
            <button type="submit">Generate Diagram</button>
            <a href="/download">
              <button type="button">Download Template</button>
            </a>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Pop-up viewer -->
  <div id="popup" class="popup" onclick="hidePopup()">
    <img id="popup-image" src="" alt="Viewer" />
  </div>

  <script>
    const dropArea = document.getElementById('drop-area');
    const fileInput = document.getElementById('file-input');
    const fileStatus = document.getElementById('file-status');

    dropArea.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropArea.classList.add('dragover');
    });

    dropArea.addEventListener('dragleave', () => {
      dropArea.classList.remove('dragover');
    });

    dropArea.addEventListener('drop', (e) => {
      e.preventDefault();
      dropArea.classList.remove('dragover');
      const files = e.dataTransfer.files;
      if (files.length > 0) {
        validateAndDisplay(files[0]);
        fileInput.files = files;
      }
    });

    fileInput.addEventListener('change', () => {
      if (fileInput.files.length > 0) {
        validateAndDisplay(fileInput.files[0]);
      }
    });

    function validateAndDisplay(file) {
      const allowedTypes = ['application/vnd.ms-excel', 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'];
      const extension = file.name.split('.').pop().toLowerCase();

      if (!allowedTypes.includes(file.type) || !['xls', 'xlsx'].includes(extension)) {
        dropArea.classList.add('error');
        fileStatus.textContent = `❌ File tidak valid: "${file.name}". Harap upload file Excel (.xls atau .xlsx).`;
        fileInput.value = '';
      } else {
        dropArea.classList.remove('error');
        fileStatus.textContent = `✅ File diterima: ${file.name}`;
      }
    }

    const popup = document.getElementById('popup');
    const img = document.getElementById('popup-image');

    function showPopup(type) {
      if (type === 'aturan') {
        img.src = '/storage/Aturan Relasi antar Metadata SPBE.png';
      } else if (type === 'archimate') {
        img.src = '/storage/Aturan Relasi Metadata ArchiMate.webp';
      }
      popup.style.display = 'flex';
    }

    function hidePopup() {
      popup.style.display = 'none';
    }

    popup.addEventListener('click', hidePopup);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') hidePopup();
    });
  </script>
</body>

</html>